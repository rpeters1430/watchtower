      "vulnerability": {
        "id": "CVE-2025-60876",
        "dataSource": "https://nvd.nist.gov/vuln/detail/CVE-2025-60876",
        "namespace": "nvd:cpe",
        "severity": "Medium",
        "urls": [
          "https://gist.github.com/subyumatest/41554af6a72aedaacaec026adc311092"
        ],
        "description": "BusyBox wget thru 1.3.7 accepted raw CR (0x0D)/LF (0x0A) and other C0 control bytes in the HTTP request-target (path/query), allowing the request line to be split and attacker-controlled headers to be injected. To preserve the HTTP/1.1 request-line shape METHOD SP request-target SP HTTP/1.1, a raw space (0x20) in the request-target must also be rejected (clients should use %20).",
        "fix": {
          "versions": [],
          "state": ""
        },
        "advisories": [],
        "risk": 0.17939999999999998
      },
      "relatedVulnerabilities": [],
